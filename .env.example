# ─── Odoo CRM (lead system of record) ───────────────────────────────────────
# JSON-RPC credentials. Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-database-name
ODOO_USERNAME=your-odoo-username@example.com
ODOO_API_KEY=your-odoo-api-key-here

# ─── Resend (lead notification email) ───────────────────────────────────────
# Get an API key from https://resend.com (free tier: 3000 emails/month).
# Until uniwater.co.in is verified in Resend, use the sandbox sender below.
# After verification, set RESEND_FROM=UNIWATER Leads <leads@uniwater.co.in>.
#
# If RESEND_API_KEY is unset, email notifications are skipped silently.

RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=UNIWATER Leads <onboarding@resend.dev>
LEAD_NOTIFY_TO=buzz.uniwater@gmail.com

# ─── Google Sheets (lead audit trail) ───────────────────────────────────────
# Apps Script Web App URL — see docs/leads-pipeline-setup.md for the script
# and deploy steps. The script writes one tab per form.
#
# If GOOGLE_SHEETS_WEBAPP_URL is unset, sheet writes are skipped silently.

GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/AKfycb.../exec

# ─── Meta (Facebook/Instagram) — Pixel + Conversions API ────────────────────
# Pixel ID: 15-digit number from Events Manager → Pixel → Settings.
# Access token: Events Manager → Pixel → Conversions API → Generate Token.
# Used by the browser pixel in components/layout/MetaPixel.tsx and the
# server-side CAPI calls in lib/meta-capi.ts.
#
# NEXT_PUBLIC_ prefix on the Pixel ID is intentional — it's safe to expose
# (the Pixel ID is in every browser's network tab anyway). The CAPI access
# token is server-only — never prefix it with NEXT_PUBLIC_.
#
# If either is unset, the corresponding sink is a silent no-op.

NEXT_PUBLIC_META_PIXEL_ID=000000000000000
META_CAPI_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx

# ─── Google reCAPTCHA v3 (form spam protection) ─────────────────────────────
# Register a new v3 site at https://www.google.com/recaptcha/admin/create
#   - reCAPTCHA type: v3 (NOT v2)
#   - Domains: uniwater.co.in (add www.uniwater.co.in too if you use both)
# Google returns a "Site key" (public, safe to expose) and a "Secret key"
# (server-only, NEVER prefix with NEXT_PUBLIC_).
#
# RECAPTCHA_MIN_SCORE: optional, defaults to 0.5. v3 scores 0.0 (bot) to
# 1.0 (human). Raise the threshold (e.g. 0.7) if spam still comes through;
# lower it (e.g. 0.3) if real users are being false-positive blocked.
#
# If either key is unset, form verification is a silent no-op and every
# submission flows through. Wire both in Vercel before the gating takes
# effect in production.

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECAPTCHA_MIN_SCORE=0.5
